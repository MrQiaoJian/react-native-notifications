{
  "name": "@react-native-ohos/react-native-notifications",
  "displayName": "React Native Notifications",
  "version": "5.1.1-beta.1",
  "description": "Advanced Push Notifications (Silent, interactive notifications) for HarmonyOS (OpenHarmony)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/react-native-oh-library/react-native-notifications.git"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/react-native-oh-library/react-native-notifications",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "src/",
    "harmony/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc --noEmit && bob build",
    "test": "jest --config ./jest/jest.config.js",
    "test:coverage": "jest --config ./jest/jest.config.js --coverage",
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/notifications/src/main/cpp/generated --ets-output-path ./harmony/notifications/src/main/ets/generated"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-notifications",
    "autolinking": {
      "cmakeLibraryTargetName": "rnoh_notifications",
      "ohPackageName": "@react-native-ohos/react-native-notifications",
      "etsPackageClassName": "NotificationsPackage",
      "cppPackageClassName": "NotificationsPackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
